{
  "name": "pastebin",
  "version": "1.0.0",
  "description": "Pastebin / GitHub Gist system design - S3 blobs, derived paths, SQLite metadata, expiration cleanup",
  "type": "module",
  "scripts": {
    "init": "tsx src/scripts/init.ts",
    "seed": "tsx src/scripts/seed.ts",
    "type-check": "tsc --noEmit",
    "demo:capacity": "tsx src/demos/demo-capacity.ts",
    "demo:storage": "tsx src/demos/demo-storage.ts",
    "demo:paste": "tsx src/demos/demo-paste.ts",
    "demo:cleanup": "tsx src/demos/demo-cleanup.ts",
    "demo:all": "tsx src/demos/demo-all.ts"
